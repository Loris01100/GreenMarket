@page "/producteur"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Mon Espace Producteur - GreenMarket</PageTitle>

<div class="page-header">
    <div class="page-header-row">
        <div class="page-header-icon">
            <FluentIcon Value="@(new Icons.Filled.Size24.BuildingShop())" Color="@Color.Custom" CustomColor="white" />
        </div>
        <div>
            <h2 class="page-title">Mon Espace Producteur</h2>
            <p class="page-subtitle">Gérez votre profil et votre activité sur GreenMarket</p>
        </div>
    </div>
</div>

<AuthorizeView Roles="Producteur,Admin">
    <Authorized>
        @if (_loading)
        {
            <div class="loading-container">
                <FluentProgressRing />
                <span class="loading-text">Chargement de votre profil...</span>
            </div>
        }
        else if (!string.IsNullOrEmpty(_erreur))
        {
            <FluentMessageBar Intent="MessageIntent.Error">@_erreur</FluentMessageBar>
        }
        else if (_producteur is null)
        {
            <FluentCard Style="padding: 32px; max-width: 500px; border-radius: 20px;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
                    <FluentIcon Value="@(new Icons.Regular.Size32.PersonAdd())" Color="@Color.Accent" />
                    <FluentLabel Typo="Typography.Header">Profil non créé</FluentLabel>
                    <FluentLabel>
                        Vous avez le rôle Producteur mais vous n'avez pas encore créé votre profil sur GreenMarket.
                    </FluentLabel>
                    <FluentButton Appearance="Appearance.Accent"
                                  OnClick="@(() => Navigation.NavigateTo("/producteur/creer"))">
                        Créer mon profil producteur
                    </FluentButton>
                </FluentStack>
            </FluentCard>
        }
        else
        {
            <div class="producteur-card">
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16">
                    <FluentIcon Value="@(new Icons.Filled.Size32.ShoppingBag())" Color="@Color.Custom" CustomColor="#2d7a4f" />
                    <FluentLabel Typo="Typography.Header">@_producteur.NomProducteur</FluentLabel>
                </FluentStack>

                <div class="producteur-info-grid">
                    <div class="info-item">
                        <label>Adresse</label>
                        <p>@_producteur.Adresse</p>
                    </div>
                    <div class="info-item">
                        <label>Membre depuis</label>
                        <p>@_producteur.DateAdhesion.ToString("dd MMMM yyyy")</p>
                    </div>
                    @if (!string.IsNullOrEmpty(_producteur.Description))
                    {
                        <div class="info-item" style="grid-column: span 2;">
                            <label>Description</label>
                            <p>@_producteur.Description</p>
                        </div>
                    }
                </div>
            </div>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
                <FluentCard Style="padding: 24px; border-radius: 16px; width: 220px; text-align: center;">
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="12">
                        <FluentIcon Value="@(new Icons.Regular.Size24.BoxMultiple())" Color="@Color.Accent" />
                        <FluentLabel Typo="Typography.Subject">Mes Produits</FluentLabel>
                        <FluentLabel Style="font-size: 0.85rem; color: #888;">Disponible prochainement</FluentLabel>
                    </FluentStack>
                </FluentCard>

                <FluentCard Style="padding: 24px; border-radius: 16px; width: 220px; text-align: center;">
                    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="12">
                        <FluentIcon Value="@(new Icons.Regular.Size24.ClipboardTask())" Color="@Color.Accent" />
                        <FluentLabel Typo="Typography.Subject">Mes Commandes</FluentLabel>
                        <FluentLabel Style="font-size: 0.85rem; color: #888;">Disponible prochainement</FluentLabel>
                    </FluentStack>
                </FluentCard>
            </FluentStack>
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private ProducteurDto? _producteur;
    private bool _loading = true;
    private string? _erreur;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var moi = await Http.GetFromJsonAsync<UtilisateurInfo>("api/utilisateurs/me");

            if (moi is null)
            {
                _erreur = "Impossible de récupérer vos informations.";
                return;
            }

            if (!moi.EstProducteur)
                return;

            var tous = await Http.GetFromJsonAsync<List<ProducteurDto>>("api/producteurs");
            _producteur = tous?.FirstOrDefault(p => p.UtilisateurId == moi.KeycloakId);
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (HttpRequestException ex)
        {
            _erreur = $"Erreur API : {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private record UtilisateurInfo(Guid KeycloakId, DateTimeOffset DateInscription, bool EstProducteur);
}
