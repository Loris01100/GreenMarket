@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject CartService Cart

<div class="app-shell">
    <header class="topbar">
        <a class="brand" href="/">
            <span class="brand-leaf">
                <FluentIcon Value="@(new Icons.Filled.Size24.PlantGrass())" Color="@Color.Custom" CustomColor="#3a9d5d" />
            </span>
            <span class="brand-name">Green<span class="brand-name-accent">Market</span></span>
        </a>

        <nav class="topnav">
            <NavLink class="topnav-link" href="/catalogue" Match="NavLinkMatch.All">Catalogue</NavLink>
            <AuthorizeView Roles="Producteur,Admin" Context="prodNav">
                <Authorized>
                    <NavLink class="topnav-link" href="/producteur">Espace Producteur</NavLink>
                </Authorized>
            </AuthorizeView>
            <AuthorizeView Roles="Admin" Context="adminNav">
                <Authorized>
                    <NavLink class="topnav-link" href="/administration">Administration</NavLink>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="topbar-right">
            <AuthorizeView>
                <Authorized>
                    <div class="user-chip" title="@context.User.Identity?.Name">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="@Color.Custom" CustomColor="#3a9d5d" />
                        <span class="user-chip-name">@(context.User.Identity?.Name ?? "Mon compte")</span>
                    </div>
                    <button class="icon-btn" title="Se déconnecter" @onclick="BeginLogout">
                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowExit())" Color="@Color.Custom" CustomColor="#5c6b62" />
                    </button>
                </Authorized>
                <NotAuthorized>
                    <button class="user-chip user-chip-action" @onclick="BeginLogin">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Person())" Color="@Color.Custom" CustomColor="#3a9d5d" />
                        <span class="user-chip-name">Se connecter</span>
                    </button>
                </NotAuthorized>
            </AuthorizeView>

            <a class="cart-btn" href="/panier" title="Mon panier">
                <FluentIcon Value="@(new Icons.Regular.Size24.Cart())" Color="@Color.Custom" CustomColor="#3a9d5d" />
                @if (Cart.NombreArticles > 0)
                {
                    <span class="cart-badge">@Cart.NombreArticles</span>
                }
            </a>
        </div>
    </header>

    <main class="app-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    Une erreur s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">X</span>
</div>

@code {
    protected override void OnInitialized() => Cart.OnChange += StateHasChanged;

    public void Dispose() => Cart.OnChange -= StateHasChanged;

    private void BeginLogin() => Navigation.NavigateToLogin("authentication/login");
    private void BeginLogout() => Navigation.NavigateToLogout("authentication/logout");
}
