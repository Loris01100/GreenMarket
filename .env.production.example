# Copier en .env.production et remplir avec de vraies valeurs (NE PAS commiter .env.production)
# Générer des mots de passe forts : openssl rand -base64 24

# --- PostgreSQL (données métier) ---
POSTGRES_DB=greenmarket_db
POSTGRES_USER=greenmarket
POSTGRES_PASSWORD=CHANGE_ME_postgres

# --- PostgreSQL (base Keycloak) ---
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db

# --- Keycloak admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin

# --- URLs publiques ---
PUBLIC_CLIENT_URL=https://greenmarket.reesch.com
PUBLIC_API_URL=https://api.reesch.com
PUBLIC_KEYCLOAK_URL=https://auth.reesch.com

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_tunnel_token

# --- Stripe (paiement) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
